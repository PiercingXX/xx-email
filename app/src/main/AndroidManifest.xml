<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The ONLY normal permission we need beyond notifications: network access to Google endpoints. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Family theme-sync: the launcher holds this permission (uses-permission only,
         never declared here) so it alone can deliver preset broadcasts to ThemeSyncReceiver. -->
    <uses-permission android:name="dev.xxemail.permission.THEME_SYNC" />

    <!-- Custom Tabs needs to see browser apps on API 30+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- T1: scoped goal implemented -->
    <!-- Family theme-sync receiver (P0). Gated by android:permission=THEME_SYNC
         (uses-permission only, no <permission> declare — the permission is defined
         in the launcher family app, this app merely consumes it), so only the
         launcher family app can deliver preset broadcasts. Maps the launcher's
         seven presets + Custom onto the M3 scheme and restyles live. -->
    <application
        android:name=".XxEmailApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XxEmail">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth redirect capture: AppAuth's library manifest merges
             net.openid.appauth.RedirectUriReceiverActivity with a VIEW filter for the
             ${appAuthRedirectScheme} placeholder ("dev.xxemail", see app/build.gradle.kts).
             Do NOT add that filter here; RedirectUriReceiverActivity must own the redirect. -->

        <!-- Family theme-sync receiver (P0): gated by android:permission=THEME_SYNC
             (uses-permission only, no <permission> declare) so only the launcher family
             app can deliver preset broadcasts. Maps the launcher's seven presets + Custom
             onto the M3 scheme and restyles live. -->
        <receiver
            android:name=".theme.ThemeSyncReceiver"
            android:exported="true"
            android:permission="dev.xxemail.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="dev.xxemail.action.THEME_SYNC" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
